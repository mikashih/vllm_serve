HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VLLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

VLLM_IMAGE=vllm/vllm-openai:latest
# 共用的 HF 模型快取（預設 /srv/models/hf）
# HF_CACHE_DIR=/srv/models/hf
PUBLIC_BASE_URL=https://example.com/llm

# Chat model
MODEL_ID=nvidia/Gemma-4-26B-A4B-NVFP4
MAX_MODEL_LEN=262144
GPU_MEM_UTIL=0.75
DTYPE=auto

# Embedding model
EMBED_MODEL_ID=google/embeddinggemma-300m
EMBED_MAX_MODEL_LEN=2048
EMBED_GPU_MEM_UTIL=0.05
EMBED_DTYPE=float32
EMBED_MAX_NUM_BATCHED_TOKENS=16384
